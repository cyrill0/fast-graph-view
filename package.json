{
  "name": "fast-graph-view",
  "version": "1.0.0",
  "private": true,
  "description": "WebGL, worker-simulated drop-in replacement for the Obsidian graph view that aggregates large folders into metadata nodes.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production && tsc -noEmit -skipLibCheck",
    "dev": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs production --watch",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --test tests/run.mjs",
    "deploy": "node tools/deploy.mjs",
    "dev:vault": "node tools/dev-vault.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "tslib": "2.8.1",
    "typescript": "5.7.2"
  }
}
